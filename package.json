{
  "name": "blocky-ui",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:studio": "bun run db:studio:mysql",
    "db:studio:mysql": "NODE_ENV=development drizzle-kit studio --config=drizzle.config.mysql.ts",
    "db:studio:pg": "NODE_ENV=development drizzle-kit studio --config=drizzle.config.postgresql.ts",
    "db:studio:sqlite": "NODE_ENV=development drizzle-kit studio --config=drizzle.config.sqlite.ts",
    "dev": "next dev --turbo",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "changeset": "bun x @changesets/cli",
    "release:version": "bun scripts/release-notes/version.ts",
    "release:format": "bun scripts/release-notes/publish.ts",
    "verify": "bun run --parallel lint typecheck knip checkdupe",
    "generate:csv": "bunx tsx scripts/generate-querylog-csv.ts --output ./generated-logs --rows 10000 --days 1",
    "generate:csv-client": "bunx tsx scripts/generate-querylog-csv.ts --output ./generated-logs --rows 10000 --days 1 --type csv-client --clients 5",
    "knip": "SKIP_ENV_VALIDATION=true knip",
    "checkdupe": "jscpd",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:update": "bun run test:e2e --update-snapshots",
    "test:watch": "vitest",
    "log-data": "bunx tsx scripts/log-data/cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-table": "9.3.1",
    "@trpc/client": "11.29.7",
    "@trpc/server": "11.29.7",
    "@trpc/tanstack-react-query": "11.29.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "7.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "ky": "2.2.0",
    "lucide-react": "1.81.0",
    "mysql2": "3.24.6",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "sonner": "2.0.8",
    "superjson": "2.2.7",
    "tailwind-merge": "3.7.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/read": "1.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query-devtools": "5.108.2",
    "@testcontainers/mysql": "12.2.2",
    "@testcontainers/postgresql": "12.2.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "better-sqlite3": "13.2.0",
    "drizzle-kit": "0.31.11",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "msw": "3.0.7",
    "node-gyp": "13.1.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "testcontainers": "12.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "8.3.1",
    "vitest": "5.1.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.15.0"
  }
}
